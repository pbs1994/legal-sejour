---
import Base from '../layouts/Base.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import FormSection from '../components/FormSection.astro';
import Delays from '../components/Delays.astro';
import { SITE } from '../data/site';
import { OQTF } from '../data/services';

const chips = [
  { l: 'Contester une OQTF', h: OQTF.href, u: true },
  { l: 'Titre de séjour', h: '/services/titre-de-sejour/' },
  { l: 'Renouvellement', h: '/services/titre-de-sejour/renouvellement/' },
  { l: 'Naturalisation', h: '/services/naturalisation/' },
  { l: 'Visa', h: '/services/visa/' },
  { l: 'Regroupement familial', h: '/services/regroupement-familial/' },
  { l: 'DALO', h: '/services/dalo/' },
  { l: 'DCEM', h: '/services/dcem/' },
];

const rows = [
  { t: 'Contestation d’OQTF', d: 'Nous rédigeons et déposons votre recours, dans les délais.', h: OQTF.href, u: true },
  { t: 'Titre de séjour', d: 'Première demande et renouvellement.', h: '/services/titre-de-sejour/' },
  { t: 'Naturalisation', d: 'Par décret, mariage, fratrie, réintégration.', h: '/services/naturalisation/' },
  { t: 'Visa', d: 'Court séjour, long séjour, étudiant, VLS-TS.', h: '/services/visa/' },
  { t: 'Regroupement familial', d: 'Faire venir votre famille en France.', h: '/services/regroupement-familial/' },
  { t: 'DALO · DCEM', d: 'Logement opposable, document de circulation pour mineur.', h: '/services/' },
];

const faq = [
  { q: 'Êtes-vous un cabinet d’avocats ?', a: `Non. ${SITE.name} est un service privé d’accompagnement administratif. Nous rédigeons vos recours et dossiers et vous accompagnons jusqu’à la décision.` },
  { q: 'Le premier rendez-vous est-il vraiment gratuit ?', a: 'Oui. 20 minutes, par téléphone ou en visio, pour comprendre votre situation et vous orienter. Sans engagement.' },
  { q: 'Combien coûte l’accompagnement ?', a: 'Chaque situation est différente. Vous recevez un devis clair après le premier rendez-vous, avant tout engagement.' },
  { q: 'J’ai reçu une OQTF, que faire ?', a: 'Contactez-nous immédiatement. Nous rédigeons votre recours et le déposons dans le délai, qui peut être de 48 heures seulement.' },
];
---
<Base title={`${SITE.name} — Accompagnement administratif, titre de séjour et OQTF`} description="Titre de séjour, naturalisation, visa, contestation d’OQTF. Accompagnement administratif à Paris et en Île-de-France. 1er rendez-vous gratuit.">
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-txt">
        <span class="eyebrow">Accompagnement administratif</span>
        <h1>Votre séjour en France, <span class="b">en règle.</span></h1>
        <p class="lead">Titre de séjour, naturalisation, visa. Et, quand chaque jour compte, la contestation d’une OQTF.</p>
        <div class="actions">
          <a href="/prendre-rendez-vous/" class="btn btn--primary">Prendre rendez-vous <span class="arrow">→</span></a>
          <a href="#formulaire" class="btn btn--ghost">Parler à un référent</a>
        </div>
      </div>
      <a class="alert" href={OQTF.href}>
        <span class="tag">Urgence</span>
        <p class="a-t">Vous avez reçu une OQTF&nbsp;?</p>
        <p class="a-d">Le délai de recours court dès la notification.</p>
        <div class="a-n"><span>48 h</span><span>7 j</span><span>30 j</span></div>
        <span class="a-go">Agir maintenant <span class="arrow">→</span></span>
      </a>
    </div>
  </section>

  <!-- Demandes -->
  <section class="chips-s">
    <div class="wrap chips-in">
      <p class="muted">Quelle est votre demande&nbsp;?</p>
      <ul class="chips">
        {chips.map((c) => <li><a href={c.h} class:list={{ u: c.u }}>{c.l}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- OQTF -->
  <section class="oqtf section">
    <div class="wrap">
      <div class="o-head reveal">
        <div>
          <span class="eyebrow light">Notre priorité</span>
          <h2>Contestation d’OQTF.</h2>
        </div>
        <p>Une obligation de quitter le territoire se conteste. Nous rédigeons votre recours et le déposons avant l’expiration du délai.</p>
      </div>
      <div class="reveal"><Delays /></div>
      <div class="actions reveal" style="margin-top:3rem">
        <a href={OQTF.href} class="btn btn--light">Comprendre la démarche <span class="arrow">→</span></a>
        <a href={`${OQTF.href}#formulaire`} class="btn btn--outline-light">Être rappelé en priorité</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Services</span>
        <h2>L’essentiel du droit au séjour.</h2>
      </div>
      <ul class="rows reveal">
        {rows.map((r, i) => (
          <li>
            <a href={r.h} class:list={{ u: r.u }}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="t">{r.t}</span>
              <span class="d">{r.d}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Steps soft />

  <!-- Engagements -->
  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Engagements</span>
        <h2>Peu de mots. Beaucoup de rigueur.</h2>
      </div>
      <div class="grid-3 reveal">
        <div class="eng"><span>01</span><h3>Un référent unique</h3><p>Une seule personne suit votre dossier, du premier échange à la décision.</p></div>
        <div class="eng"><span>02</span><h3>Un dossier vérifié</h3><p>Chaque pièce est contrôlée avant dépôt. Rien n’est laissé au hasard.</p></div>
        <div class="eng"><span>03</span><h3>Un devis clair</h3><p>Vous connaissez le prix avant de vous engager. Aucune surprise.</p></div>
      </div>
    </div>
  </section>

  <Faq items={faq} />
  <FormSection />
</Base>

<style>
  .hero { padding: clamp(4rem, 10vw, 8.5rem) 0 clamp(4rem, 8vw, 7rem); }
  .hero-in { display: grid; grid-template-columns: 1.55fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: end; }
  .hero-txt { display: grid; gap: 2rem; }
  .hero h1 .b { color: var(--brand); }
  .alert { background: var(--night); color: #fff; border-radius: calc(var(--radius) * 1.5); padding: 2.25rem; display: grid; gap: 1rem; transition: transform .25s, box-shadow .25s; }
  .alert:hover { transform: translateY(-3px); box-shadow: 0 30px 80px -30px rgba(12,26,51,.6); }
  .tag { justify-self: start; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; padding: .35rem .7rem; border-radius: 999px; background: var(--urgent); font-weight: 500; }
  .a-t { font-size: 1.6rem; line-height: 1.15; letter-spacing: -.02em; font-weight: 450; }
  .a-d { color: rgba(255,255,255,.65); font-size: .98rem; }
  .a-n { display: flex; gap: 1.5rem; padding: 1.25rem 0; margin: .5rem 0; border-top: 1px solid rgba(255,255,255,.12); border-bottom: 1px solid rgba(255,255,255,.12); font-size: 1.6rem; font-weight: 300; }
  .a-n span:first-child { color: #ff6b7f; }
  .a-go { font-weight: 500; }

  .chips-s { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.5rem 0; }
  .chips-in { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .chips { display: flex; flex-wrap: wrap; gap: .6rem; }
  .chips a { display: inline-block; padding: .55rem 1.05rem; border: 1px solid var(--line); border-radius: 999px; font-size: .92rem; color: var(--ink); transition: border-color .2s, color .2s, background .2s; }
  .chips a:hover { border-color: var(--brand); color: var(--brand); }
  .chips a.u { border-color: var(--urgent); color: var(--urgent); }
  .chips a.u:hover { background: var(--urgent); color: #fff; }

  .oqtf { background: var(--night); color: #fff; }
  .oqtf h2 { color: #fff; margin-top: 1.25rem; }
  .eyebrow.light { color: var(--accent); }
  .o-head { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .o-head p { color: rgba(255,255,255,.7); font-size: 1.2rem; max-width: 36ch; }

  .rows { border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .rows a { display: grid; grid-template-columns: 4rem 1.1fr 1.3fr 2rem; gap: 1.5rem; align-items: center; padding: 2rem 0; transition: padding .25s, color .2s; }
  .rows a:hover { padding-left: .75rem; }
  .rows .n { color: var(--muted); font-size: .85rem; letter-spacing: .08em; }
  .rows .t { font-size: clamp(1.35rem, 2.4vw, 1.9rem); color: var(--ink); letter-spacing: -.02em; }
  .rows .d { color: var(--muted); }
  .rows .arrow { color: var(--brand); font-size: 1.3rem; justify-self: end; }
  .rows a:hover .t { color: var(--brand); }
  .rows a.u .t { color: var(--urgent); }
  .rows a.u .n { color: var(--urgent); }

  .eng { display: grid; gap: 1rem; padding-top: 2rem; border-top: 1px solid var(--ink); }
  .eng span { font-size: .85rem; color: var(--brand); letter-spacing: .08em; }
  .eng p { color: var(--muted); }

  @media (max-width: 960px) {
    .hero-in { grid-template-columns: 1fr; }
    .o-head { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .rows a { grid-template-columns: 2.5rem 1fr 1.5rem; row-gap: .4rem; }
    .rows .d { grid-column: 2; grid-row: 2; font-size: .95rem; }
    .rows .arrow { grid-column: 3; grid-row: 1; }
  }
</style>
