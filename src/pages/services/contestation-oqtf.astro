---
import Base from '../../layouts/Base.astro';
import Delays from '../../components/Delays.astro';
import Faq from '../../components/Faq.astro';
import FormSection from '../../components/FormSection.astro';
import { SITE, telHref } from '../../data/site';

const how = [
  { t: 'Analyse de la décision', d: 'Nature de la mesure, délai applicable, arguments à soulever.' },
  { t: 'Rédaction du recours', d: 'Nous rédigeons votre requête devant le tribunal administratif.' },
  { t: 'Pièces et dépôt', d: 'Preuves rassemblées, classées, déposées dans le délai.' },
  { t: 'Suivi jusqu’au jugement', d: 'Mémoires complémentaires, préparation de l’audience.' },
];
const keep = ['La décision et l’enveloppe de notification', 'La date exacte de remise ou de réception', 'Toute preuve de votre présence et de vos attaches en France'];
const cases = ['Refus de titre de séjour avec OQTF', 'OQTF après rejet d’une demande d’asile', 'OQTF à la suite d’un contrôle', 'Interdiction de retour (IRTF)', 'Assignation à résidence', 'Placement en rétention'];
const faq = [
  { q: 'Le recours suspend-il l’OQTF ?', a: 'Le recours devant le tribunal administratif empêche en principe l’exécution de la mesure tant que le juge n’a pas statué. D’où l’importance de le former dans le délai.' },
  { q: 'Le délai est dépassé. Est-ce trop tard ?', a: 'Pas toujours. Une erreur dans la notification ou un changement de situation peut ouvrir d’autres voies. Contactez-nous pour vérifier.' },
  { q: 'Faut-il un avocat ?', a: 'Non. Devant le tribunal administratif, le recours contre une OQTF peut être présenté sans avocat. Nous rédigeons votre requête, réunissons les pièces et préparons l’audience avec vous.' },
  { q: 'Combien de temps pour rédiger le recours ?', a: 'Dans les délais de votre décision, y compris en 48 heures. Les dossiers OQTF sont traités en priorité.' },
  { q: 'Que dois-je apporter au premier échange ?', a: 'La décision, l’enveloppe, votre titre ou récépissé s’il existe, et tout document prouvant votre vie en France.' },
];
---
<Base title="Contestation d’OQTF — agir dans les délais" description="Vous avez reçu une OQTF ? Nous rédigeons votre recours devant le tribunal administratif et le déposons dans le délai : 30 jours, 7 jours ou 48 heures.">
  <section class="hero">
    <div class="wrap">
      <nav class="crumbs light" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span>Contestation d’OQTF</span></nav>
      <div class="h-in">
        <div class="h-txt">
          <span class="tag">Priorité</span>
          <h1>Contestation d’OQTF.</h1>
          <p class="sub">Une OQTF n’est pas une fin. <span>Le délai, si.</span><br />Nous rédigeons votre recours et le déposons dans les temps.</p>
          <div class="actions">
            <a href="#formulaire" class="btn btn--urgent">Être rappelé en priorité <span class="arrow">→</span></a>
            {SITE.phone
              ? <a href={telHref(SITE.phone)} class="btn btn--outline-light">{SITE.phone}</a>
              : <a href="/prendre-rendez-vous/" class="btn btn--outline-light">Prendre rendez-vous</a>}
          </div>
        </div>
      </div>
      <div class="dl"><Delays /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Notre intervention</span>
        <h2>Votre recours, rédigé et déposé.</h2>
      </div>
      <ol class="steps reveal">
        {how.map((s, i) => <li><span class="n">0{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap two">
      <div class="reveal">
        <span class="eyebrow">Dès aujourd’hui</span>
        <h2 class="mt">Gardez précieusement.</h2>
      </div>
      <ul class="ticks big reveal">{keep.map((k) => <li>{k}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="reveal">
        <span class="eyebrow">Situations</span>
        <h2 class="mt">Nous intervenons notamment en cas de :</h2>
      </div>
      <ul class="cases reveal">{cases.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <Faq items={faq} />
  <FormSection oqtf title="Chaque heure compte." />
</Base>

<style>
  .hero { background: var(--night); color: #fff; padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(4rem, 8vw, 6.5rem); }
  .crumbs.light { color: rgba(255,255,255,.5); }
  .crumbs.light a:hover { color: #fff; }
  .h-txt { display: grid; gap: 1.75rem; max-width: 52rem; }
  .tag { justify-self: start; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; padding: .35rem .75rem; border-radius: 999px; background: var(--urgent); font-weight: 500; }
  h1 { color: #fff; }
  .sub { font-size: clamp(1.3rem, 2.4vw, 1.75rem); color: rgba(255,255,255,.7); font-weight: 300; }
  .sub span { color: #fff; }
  .dl { margin-top: clamp(4rem, 8vw, 6rem); }
  .two { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .mt { margin-top: 1.25rem; }
  .ticks.big { font-size: 1.2rem; color: var(--ink); gap: 1.4rem; }
  .cases { border-top: 1px solid var(--line); }
  .cases li { padding: 1.25rem 0; border-bottom: 1px solid var(--line); font-size: 1.15rem; color: var(--ink); }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
</style>
