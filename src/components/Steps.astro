---
import { STEPS } from '../data/site';
const { title = 'Quatre étapes, un seul interlocuteur.', eyebrow = 'Processus', soft = false } = Astro.props;
---
<section class:list={['section', { 'section--soft': soft }]}>
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
    <ol class="steps reveal">
      {STEPS.map((s, i) => (
        <li><span class="n">0{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
      ))}
    </ol>
  </div>
</section>
