---
import { getLang, t } from '../i18n';
const T = t(getLang(Astro.url)).steps;
const { title = T.title, eyebrow = T.eyebrow, soft = false } = Astro.props;
---
<section class:list={['section', { 'section--soft': soft }]}>
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
    <ol class="steps reveal">
      {T.items.map((s, i) => (
        <li><span class="n">0{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
      ))}
    </ol>
  </div>
</section>
