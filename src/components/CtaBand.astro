---
import PhoneBtn from './PhoneBtn.astro';
import { getLang, t, lp } from '../i18n';
const lang = getLang(Astro.url);
const C = t(lang).cta;
const { title = C.title, text = C.text } = Astro.props;
---
<section class="band">
  <div class="wrap in reveal">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a href={lp(lang, '/prendre-rendez-vous/')} class="btn btn--light">{C.btn} <span class="arrow">→</span></a>
      <PhoneBtn variant="outline-light" />
    </div>
  </div>
</section>
<style>
  .band { background: var(--brand); color: #fff; padding: clamp(4rem, 8vw, 6.5rem) 0; }
  .in { display: flex; justify-content: space-between; align-items: end; gap: 2.5rem; flex-wrap: wrap; }
  h2 { color: #fff; max-width: 18ch; }
  p { margin-top: 1rem; color: rgba(255,255,255,.75); font-size: 1.1rem; }
</style>
