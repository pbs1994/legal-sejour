---
import { SERVICES, OQTF } from '../data/services';
interface Props { service?: string; oqtf?: boolean; booking?: boolean; dark?: boolean }
const { service = '', oqtf = false, booking = false, dark = false } = Astro.props;
const options = [OQTF.menu, ...SERVICES.filter((s) => !s.parent).map((s) => s.menu), 'Autre demande'];
const selected = oqtf ? OQTF.menu : service;
---
<form class:list={['lead', { dark }]} action="/api/contact.php" method="post" data-lead novalidate>
  {booking && <slot name="booking" />}
  <div class="row">
    <div class="field"><label for="f-first">Prénom *</label><input id="f-first" name="firstname" autocomplete="given-name" required /></div>
    <div class="field"><label for="f-last">Nom *</label><input id="f-last" name="lastname" autocomplete="family-name" required /></div>
  </div>
  <div class="row">
    <div class="field"><label for="f-email">E-mail *</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
    <div class="field"><label for="f-phone">Téléphone *</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" required /></div>
  </div>
  <div class="row">
    <div class="field">
      <label for="f-service">Votre demande</label>
      <select id="f-service" name="service">
        {!selected && <option value="" selected disabled>Sélectionnez…</option>}
        {options.map((o) => <option selected={o === selected}>{o}</option>)}
      </select>
    </div>
    {oqtf && (
      <div class="field"><label for="f-notif">Date de notification de l’OQTF</label><input id="f-notif" name="notified" type="date" /></div>
    )}
  </div>
  <div class="field"><label for="f-msg">Message <span class="opt">(facultatif)</span></label><textarea id="f-msg" name="message" rows="3"></textarea></div>
  <div class="hp" aria-hidden="true"><label>Site web<input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <input type="hidden" name="elapsed" value="0" />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <label class="consent"><input type="checkbox" name="consent" value="1" required /> <span>J’accepte que mes données soient utilisées pour être recontacté(e). <a href="/politique-de-confidentialite/">En savoir plus</a></span></label>
  <div class="submit">
    <button class:list={['btn', oqtf ? 'btn--urgent' : 'btn--primary']} type="submit">{oqtf ? 'Être rappelé en priorité' : booking ? 'Confirmer ma demande' : 'Envoyer ma demande'} <span class="arrow">→</span></button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lead]').forEach((form) => {
    const t0 = Date.now();
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      (form.elements.namedItem('elapsed') as HTMLInputElement).value = String(Math.round((Date.now() - t0) / 1000));
      btn.disabled = true; status.dataset.state = ''; status.textContent = 'Envoi…';
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const j = await r.json().catch(() => ({ ok: false }));
        if (!r.ok || !j.ok) throw new Error();
        status.dataset.state = 'ok';
        status.textContent = 'Merci. Votre demande est bien reçue, nous vous recontactons rapidement.';
        form.reset();
      } catch {
        status.dataset.state = 'err';
        status.textContent = 'L’envoi a échoué. Écrivez-nous à contact@legal-sejour.fr.';
      } finally { btn.disabled = false; }
    });
  });
</script>

<style>
  .lead { display: grid; gap: 1.25rem; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .row:has(> :only-child) { grid-template-columns: 1fr; }
  .opt { color: var(--muted); font-weight: 350; }
  .submit { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; margin-top: .5rem; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>
