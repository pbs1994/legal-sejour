---
import LeadForm from './LeadForm.astro';
import PhoneBtn from './PhoneBtn.astro';
import { getLang, t } from '../i18n';
const S = t(getLang(Astro.url)).formSection;
const { service = '', oqtf = false, title = S.title } = Astro.props;
const ticks = oqtf ? S.ticksOqtf : S.ticks;
---
<section class="section section--soft" id="formulaire">
  <div class="wrap fs">
    <div class="reveal intro">
      <span class="eyebrow">{oqtf ? S.eyebrowOqtf : S.eyebrow}</span>
      <h2>{title}</h2>
      <ul class="ticks">
        {ticks.map((x) => <li><span set:html={x} /></li>)}
      </ul>
      <div class="call"><p class="muted">{oqtf ? S.callOqtf : S.call}</p><PhoneBtn variant={oqtf ? 'primary' : 'ghost'} /></div>
    </div>
    <div class="box reveal"><LeadForm service={service} oqtf={oqtf} /></div>
  </div>
</section>
<style>
  .fs { display: grid; grid-template-columns: 1fr 1.35fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .intro { display: grid; gap: 1.75rem; position: sticky; top: 7.5rem; }
  .call { display: grid; gap: .75rem; justify-items: start; padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .box { background: #fff; border-radius: calc(var(--radius) * 1.5); padding: clamp(1.5rem, 4vw, 3rem); box-shadow: 0 4px 24px -4px rgba(41,73,138,.08); }
  @media (max-width: 900px) { .fs { grid-template-columns: 1fr; } .intro { position: static; } }
</style>
